# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=urx

# API / mobile clients (comma-separated origins for web shells: Expo web, Capacitor, etc.)
# Native iOS/Android apps do not use CORS; this is for browser-based mobile shells.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth (add when implementing mobile JWT flow)
# JWT_SECRET=replace-with-long-random-secret
