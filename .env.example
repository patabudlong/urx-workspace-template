# MongoDB (local Docker — run `pnpm docker:up` first)
MONGODB_URI=mongodb://urx:urx@localhost:27017/urx-workspace?authSource=admin
MONGODB_DB_NAME=urx-workspace

# API / mobile clients (comma-separated origins for web shells: Expo web, Capacitor, etc.)
# Native iOS/Android apps do not use CORS; this is for browser-based mobile shells.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

#----------------------------------------------------------------------------------------------------
# Auth — required for signing new tokens (min 32 characters)
JWT_SECRET=qpaTNpgCChuPMpdLpvlJXHg7Mzz9Db7QjMLy5Egn-hSbG2PHQwRCKy61K49eUyh6


# Optional — previous signing key during rotation overlap (verify only, not sign)
# Set automatically by `pnpm rotate:jwt-secret`. Remove after access tokens expire (7 days).
JWT_SECRET_PREVIOUS=replace-with-a-long-random-secret-at-least-32-chars
#----------------------------------------------------------------------------------------------------

# Optional dev seed overrides (pnpm seed:user) — uncomment to use
# SEED_USER_EMAIL=admin@urx.local
# SEED_USER_PASSWORD=changeme123
# SEED_USER_FIRST_NAME=Admin
# SEED_USER_LAST_NAME=User
#----------------------------------------------------------------------------------------------------

# SMTP (local MailHog — run `pnpm docker:up` first; UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@urx.local


#----------------------------------------------------------------------------------------------------

# Google OAuth (web sign-in)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI (local): http://localhost:5173/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

#----------------------------------------------------------------------------------------------------

# Google reCAPTCHA v3 (optional — leave blank to disable in local dev)
# PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
# RECAPTCHA_MIN_SCORE=0.5

#----------------------------------------------------------------------------------------------------

# Brand colors — sampled from the Urixoft logo (6-digit hex, include #)
PUBLIC_BRAND_PRIMARY=#0471B7
PUBLIC_BRAND_SECONDARY=#2A93CF
PUBLIC_BRAND_TERTIARY=#C8E6F7

#----------------------------------------------------------------------------------------------------
