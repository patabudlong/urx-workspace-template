# MongoDB (local Docker — run `pnpm docker:up` first)
MONGODB_URI=mongodb://urx:urx@localhost:27017/urx-workspace?authSource=admin
MONGODB_DB_NAME=urx-workspace


# API / mobile clients (comma-separated origins for web shells: Expo web, Capacitor, etc.)
# Native iOS/Android apps do not use CORS; this is for browser-based mobile shells.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

#----------------------------------------------------------------------------------------------------
# Auth — required for signing new tokens (min 32 characters)
JWT_SECRET=


# Optional — previous signing key during rotation overlap (verify only, not sign)
# Set automatically by `pnpm rotate:jwt-secret`. Remove after access tokens expire (7 days).
JWT_SECRET_PREVIOUS=
#----------------------------------------------------------------------------------------------------

# Optional dev seed overrides (pnpm seed:user) — uncomment to use
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_FIRST_NAME=Super
SEED_USER_LAST_NAME=Admin
#----------------------------------------------------------------------------------------------------

# Brand colors — sampled from the Urixoft logo (6-digit hex, include #)
PUBLIC_BRAND_PRIMARY=#0471B7
PUBLIC_BRAND_SECONDARY=#2A93CF
PUBLIC_BRAND_TERTIARY=#C8E6F7

#----------------------------------------------------------------------------------------------------

# Google reCAPTCHA v3 (optional — leave blank to disable in local dev)
PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

#----------------------------------------------------------------------------------------------------

# Auth rate limiting — set AUTH_RATE_LIMIT_ENABLED=false to disable while testing locally
# AUTH_RATE_LIMIT_ENABLED=false
# AUTH_RATE_LIMIT_MAX=20
# AUTH_RATE_LIMIT_WINDOW_SECONDS=900

#----------------------------------------------------------------------------------------------------

# Google OAuth (web sign-in)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Google does NOT accept *.localhost origins — use plain localhost for local dev.
# Local:
#   GOOGLE_OAUTH_ORIGIN=http://localhost:5173
#   Authorized JavaScript origin: http://localhost:5173
#   Authorized redirect URI:      http://localhost:5173/auth/google/callback
# Production:
#   GOOGLE_OAUTH_ORIGIN=https://workspace.urixoft.com
#   Authorized redirect URI:      https://workspace.urixoft.com/auth/google/callback
# If the consent screen is in Testing, add each sign-in email under Test users.
GOOGLE_OAUTH_ORIGIN=http://localhost:5173
PUBLIC_GOOGLE_OAUTH_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

#----------------------------------------------------------------------------------------------------

# SMTP (local MailHog — run `pnpm docker:up` first; UI at http://localhost:8025)
# Provider: smtp (default, MailHog/local) or postmark

MAIL_PROVIDER=smtp
#MAIL_PROVIDER=postmark
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@urixoft.com.local
# POSTMARK_SERVER_TOKEN=  # required when MAIL_PROVIDER=postmark

#----------------------------------------------------------------------------------------------------

# Workspace onboarding — team inbox for new owner requests (also used in notification emails)
WORKSPACE_REVIEW_TEAM_EMAIL=support@urixoft.com

# Tenant workspace URLs — users land on https://{slug}.WORKSPACE_HOST_SUFFIX
# Local dev: use slug.workspace.localhost:5173 (e.g. acme.workspace.localhost:5173)
WORKSPACE_HOST_SUFFIX=workspace.localhost
PUBLIC_WORKSPACE_HOST_SUFFIX=workspace.localhost

# Optional — share the session cookie across workspace subdomains.
# Production: SESSION_COOKIE_DOMAIN=.workspace.urixoft.com
# Local dev: leave unset — browsers reject shared cookies on *.localhost.
# SESSION_COOKIE_DOMAIN=.workspace.localhost

# Comma-separated emails that can access /admin/workspace-requests (in addition to platformRole superadmin)
SUPERADMIN_EMAILS=superadmin@urixoft.com,jun@urixoft.com

#----------------------------------------------------------------------------------------------------

# Auth rate limiting (web forms + /api/v1/auth/*). Disabled by default in local dev unless set.
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX=15
AUTH_RATE_LIMIT_WINDOW_SECONDS=600

# Stricter defaults for forgot-password (per IP): 5 requests / hour minutes
AUTH_RATE_LIMIT_FORGOT_PASSWORD_MAX=5
AUTH_RATE_LIMIT_FORGOT_PASSWORD_WINDOW_SECONDS=600

# Per-email forgot-password cap (silent — still returns success to avoid enumeration): 5 / 10 minutes
AUTH_FORGOT_PASSWORD_EMAIL_MAX=3
AUTH_FORGOT_PASSWORD_EMAIL_WINDOW_SECONDS=600

# Per-email verification cap (silent): 5 / 10 minutes
AUTH_VERIFICATION_EMAIL_MAX=5
AUTH_VERIFICATION_EMAIL_WINDOW_SECONDS=600

#----------------------------------------------------------------------------------------------------

# Linode Object Storage (S3-compatible) for workspace logos
# Required in production. Local dev falls back to static/workspace-branding/ when unset.
LINODE_ENDPOINT=
LINODE_BUCKET=
LINODE_ACCESS_KEY=
LINODE_SECRET_KEY=
LINODE_REGION=
LINODE_PUBLIC_BASE=
#----------------------------------------------------------------------------------------------------