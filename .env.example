# MongoDB — switch with MONGODB_TARGET: local | atlas (restart `pnpm dev` after change)
# local: run `pnpm docker:up` first
# atlas: Network Access must allow your IP; Database Access user must match the URI
MONGODB_TARGET=local
MONGODB_URI_LOCAL=mongodb://urx:urx@localhost:27017/urx-workspace?authSource=admin
MONGODB_URI_ATLAS=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=urx-cluster&retryWrites=true&w=majority
MONGODB_DB_NAME=urx-workspace


# API / mobile clients (comma-separated origins for web shells: Expo web, Capacitor, etc.)
# Native iOS/Android apps do not use CORS; this is for browser-based mobile shells.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

#----------------------------------------------------------------------------------------------------
# Auth — required for signing new tokens (min 32 characters)
JWT_SECRET=


# Optional — previous signing key during rotation overlap (verify only, not sign)
# Set automatically by `pnpm rotate:jwt-secret`. Remove after access tokens expire (7 days).
JWT_SECRET_PREVIOUS=
#----------------------------------------------------------------------------------------------------

# Optional dev seed overrides (pnpm seed:user)
SEED_USER_EMAIL=superadmin@urixoft.com
SEED_USER_PASSWORD=urx-sa-Pass1234!
SEED_USER_FIRST_NAME=Super
SEED_USER_LAST_NAME=Admin
#----------------------------------------------------------------------------------------------------

# Brand colors — sampled from the Urixoft logo (6-digit hex, include #)
PUBLIC_BRAND_PRIMARY=#0471B7
PUBLIC_BRAND_SECONDARY=#2A93CF
PUBLIC_BRAND_TERTIARY=#C8E6F7

#----------------------------------------------------------------------------------------------------

# Google reCAPTCHA v3 (optional — leave blank to disable in local dev)
PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

#----------------------------------------------------------------------------------------------------

# Auth rate limiting — set AUTH_RATE_LIMIT_ENABLED=false to disable while testing locally
# AUTH_RATE_LIMIT_ENABLED=false
# AUTH_RATE_LIMIT_MAX=20
# AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# Team invitation rate limits (honors AUTH_RATE_LIMIT_ENABLED)
# TEAM_INVITE_FORM_MAX=20
# TEAM_INVITE_FORM_WINDOW_SECONDS=900
# TEAM_INVITE_WORKSPACE_MAX=30
# TEAM_INVITE_WORKSPACE_WINDOW_SECONDS=3600
# TEAM_INVITE_EMAIL_MAX=3
# TEAM_INVITE_EMAIL_WINDOW_SECONDS=3600

#----------------------------------------------------------------------------------------------------

# Google OAuth (web sign-in)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Google does NOT accept *.localhost origins — use plain localhost for local dev.
# Local:
#   GOOGLE_OAUTH_ORIGIN=http://localhost:5173
#   Authorized JavaScript origin: http://localhost:5173
#   Authorized redirect URI:      http://localhost:5173/auth/google/callback
# Production:
#   GOOGLE_OAUTH_ORIGIN=https://workspace.urixoft.com
#   Authorized redirect URI:      https://workspace.urixoft.com/auth/google/callback
# If the consent screen is in Testing, add each sign-in email under Test users.
GOOGLE_OAUTH_ORIGIN=http://localhost:5173
PUBLIC_GOOGLE_OAUTH_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

#----------------------------------------------------------------------------------------------------

# Email transport — mailhog (local) or postmark (real delivery)
# Switch MAIL_PROVIDER and restart `pnpm dev` after changing.
# MAIL_PROVIDER=postmark
MAIL_PROVIDER=mailhog

# MailHog — when MAIL_PROVIDER=mailhog (pnpm docker:up, UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Urixoft Platform <noreply@urixoft.com.local>"

# Postmark — when MAIL_PROVIDER=postmark
# POSTMARK_SERVER_TOKEN=
# POSTMARK_FROM="Urixoft Platform <connect@urixoft.com>"
# POSTMARK_MESSAGE_STREAM=outbound

#----------------------------------------------------------------------------------------------------

# SMS (local SMSPit — run `pnpm docker:up` first; UI at http://localhost:2875)
# Provider: smspitt (SMSPit mock API) or log (console only in dev)

SMS_PROVIDER=smspitt
SMSPITT_URL=http://localhost:2876
SMS_FROM=URX-WORKSPACE

# Per-phone verification SMS cap: 3 / hour (honors AUTH_RATE_LIMIT_ENABLED)
# AUTH_VERIFICATION_SMS_MAX=3
# AUTH_VERIFICATION_SMS_WINDOW_SECONDS=3600
# Per-user verification SMS cap across numbers: 5 / hour
# AUTH_VERIFICATION_SMS_USER_MAX=5
# AUTH_VERIFICATION_SMS_USER_WINDOW_SECONDS=3600
# Account phone form actions (update / resend / verify) per IP: 15 / 10 min
# ACCOUNT_PHONE_FORM_MAX=15
# ACCOUNT_PHONE_FORM_WINDOW_SECONDS=600
# Verify-code attempts per user: 10 / 15 min
# ACCOUNT_PHONE_VERIFY_CODE_MAX=10
# ACCOUNT_PHONE_VERIFY_CODE_WINDOW_SECONDS=900
# Two-factor OTP resend (setup + login): per user 5 / hour, per email 5 / hour, per IP 10 / 15 min
# SMS resends also count toward AUTH_VERIFICATION_SMS_* limits above
# AUTH_TWO_FACTOR_OTP_USER_MAX=5
# AUTH_TWO_FACTOR_OTP_USER_WINDOW_SECONDS=3600
# AUTH_TWO_FACTOR_OTP_EMAIL_MAX=5
# AUTH_TWO_FACTOR_OTP_EMAIL_WINDOW_SECONDS=3600
# AUTH_TWO_FACTOR_OTP_IP_MAX=10
# AUTH_TWO_FACTOR_OTP_IP_WINDOW_SECONDS=900

#----------------------------------------------------------------------------------------------------

# Workspace onboarding — team inbox for new owner requests (also used in notification emails)
WORKSPACE_REVIEW_TEAM_EMAIL=support@urixoft.com

# Tenant workspace URLs — users land on https://{slug}.WORKSPACE_HOST_SUFFIX
# Local dev: use slug.workspace.localhost:5173 (e.g. acme.workspace.localhost:5173)
WORKSPACE_HOST_SUFFIX=workspace.localhost
PUBLIC_WORKSPACE_HOST_SUFFIX=workspace.localhost

# Links in transactional emails always use the platform host (no tenant subdomain).
# Optional override — otherwise derived from WORKSPACE_HOST_SUFFIX + request port.
# PLATFORM_WORKSPACE_ORIGIN=http://workspace.localhost:5173

# Optional — share the session cookie across workspace subdomains.
# Production: SESSION_COOKIE_DOMAIN=.workspace.urixoft.com
# Local dev: leave unset — browsers reject shared cookies on *.localhost.
# SESSION_COOKIE_DOMAIN=.workspace.localhost

# Comma-separated emails that can access /admin/workspace-requests (in addition to platformRole superadmin)
SUPERADMIN_EMAILS=superadmin@urixoft.com,jun@urixoft.com

#----------------------------------------------------------------------------------------------------

# Auth rate limiting (web forms + /api/v1/auth/*). Disabled by default in local dev unless set.
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX=15
AUTH_RATE_LIMIT_WINDOW_SECONDS=600

# Stricter defaults for forgot-password (per IP): 5 requests / hour minutes
AUTH_RATE_LIMIT_FORGOT_PASSWORD_MAX=5
AUTH_RATE_LIMIT_FORGOT_PASSWORD_WINDOW_SECONDS=600

# Per-email forgot-password cap (silent — still returns success to avoid enumeration): 5 / 10 minutes
AUTH_FORGOT_PASSWORD_EMAIL_MAX=3
AUTH_FORGOT_PASSWORD_EMAIL_WINDOW_SECONDS=600

# Per-email verification cap (silent): 5 / 10 minutes
AUTH_VERIFICATION_EMAIL_MAX=5
AUTH_VERIFICATION_EMAIL_WINDOW_SECONDS=600

#----------------------------------------------------------------------------------------------------

# Linode Object Storage (S3-compatible) for workspace logos and public email assets
# Required in production. Local dev falls back to static/workspace-branding/ and static/email/ when unset.
# Email assets: run `pnpm upload:email-assets` to sync static/email/* to {LINODE_PUBLIC_BASE}/email/
LINODE_ENDPOINT=
LINODE_BUCKET=
LINODE_ACCESS_KEY=
LINODE_SECRET_KEY=
LINODE_REGION=
LINODE_PUBLIC_BASE=
#----------------------------------------------------------------------------------------------------

# urixoft-workspace-mailbox
# Namecheap PrivateEmail — optional server defaults (per-user credentials stored encrypted in MongoDB)
# IMAP: mail.privateemail.com:993 SSL
# SMTP: mail.privateemail.com:465 SSL (or 587 SSL/TLS — set MAILBOX_SMTP_PORT=587)
MAILBOX_IMAP_HOST=mail.privateemail.com
MAILBOX_IMAP_PORT=993
MAILBOX_IMAP_SECURE=true
MAILBOX_SMTP_HOST=mail.privateemail.com
MAILBOX_SMTP_PORT=465
MAILBOX_SMTP_SECURE=true
# urixoft-workspace-mailbox:end

# urixoft-workspace-payroll
# Default timezone for pay period boundaries (IANA name)
PAYROLL_DEFAULT_TIMEZONE=Asia/Manila
# Default currency for new workspaces (ISO 4217 code)
PAYROLL_DEFAULT_CURRENCY=PHP
# urixoft-workspace-payroll:end

# urixoft-workspace-dtr
# Requires urixoft-workspace-payroll to be installed first.
# urixoft-workspace-dtr:end
