{
	"name": "urx-workspace-template",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.15.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"docker:up": "docker compose up -d",
		"docker:down": "docker compose down",
		"docker:down:clean": "docker compose down -v",
		"docker:logs": "docker compose logs -f mongo",
		"docker:ps": "docker compose ps",
		"seed:user": "node --import tsx scripts/seed-dev-user.ts",
		"rotate:jwt-secret": "node --import tsx scripts/rotate-jwt-secret.ts",
		"rotate:jwt-secret:dry": "node --import tsx scripts/rotate-jwt-secret.ts --dry-run",
		"upload:email-assets": "node --import tsx scripts/upload-email-assets.ts",
		"workspace:mailbox:install": "node ../urx-workspace-mailbox/bin/cli.mjs install",
		"workspace:mailbox:sync": "node ../urx-workspace-mailbox/bin/cli.mjs sync",
		"workspace:mailbox:uninstall": "node ../urx-workspace-mailbox/bin/cli.mjs uninstall"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.31.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bcryptjs": "^3.0.0",
		"@types/mailparser": "^3.4.6",
		"@types/node": "^26.1.2",
		"@types/nodemailer": "^8.0.1",
		"@types/qrcode": "^1.5.6",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"formsnap": "^2.0.1",
		"imapflow": "^1.0.193",
		"mailparser": "^3.7.4",
		"mode-watcher": "^1.1.0",
		"shadcn-svelte": "^1.4.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.1.1",
		"sveltekit-superforms": "^2.30.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1101.0",
		"@scalar/sveltekit": "^0.3.11",
		"bcryptjs": "^3.0.3",
		"jose": "^6.2.5",
		"mongodb": "^7.5.0",
		"nodemailer": "^9.0.3",
		"otplib": "^13.4.1",
		"qrcode": "^1.5.4",
		"zod": "^4.4.3"
	}
}
